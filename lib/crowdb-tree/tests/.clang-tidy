# Inherit every repository check; only drop diagnostics whose cause lives in
# a third-party test-framework macro body instead of CROWDB code.
InheritParentConfig: true
# gtest's TEST()/TEST_F() expand to a static `test_info_` initialized from a
# throwing std::string constructor. clang-tidy reports the warning at the
# TEST() line in our file, but there is no fix available in CROWDB code.
Checks: '-bugprone-throwing-static-initialization'
