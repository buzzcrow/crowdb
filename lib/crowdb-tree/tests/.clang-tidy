# Inherit repository checks, with exceptions for test-framework macros and
# deliberate regression-test behavior. Production checks remain enabled.
InheritParentConfig: true
# gtest's TEST()/TEST_F() expand to a static `test_info_` initialized from a
# throwing std::string constructor. clang-tidy reports the warning at the
# TEST() line in our file, but there is no fix available in CROWDB code.
# Fixed seeds keep randomized cases reproducible. Credit ownership tests also
# inspect the documented empty state of moved-from objects.
Checks: >-
  -bugprone-throwing-static-initialization,
  -bugprone-random-generator-seed,
  -bugprone-use-after-move,
  -clang-analyzer-cplusplus.Move
