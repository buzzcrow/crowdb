+#pragma once
+#include "numa.hpp"
+#include <memory_resource>
+#include <limits>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace experimental::execution {
+struct pool_thread_factory {
+  void* context{};
+  void* (*start)(void*, void (*)(void*, std::uint32_t) noexcept, void*, std::uint32_t){};
+  void (*join)(void*) noexcept{};
+  std::thread::id (*id)(void*) noexcept{};
+};
+namespace _pool_ {
+template<class T> class pool_allocator {
+public:
+  using value_type = T;
+  explicit pool_allocator(std::pmr::memory_resource* resource = nullptr, int node = 0) noexcept
+    : resource_(resource), node_(node) {}
+  template<class U> pool_allocator(const pool_allocator<U>& other) noexcept
+    : resource_(other.resource_), node_(other.node_) {}
+  std::pmr::memory_resource* resource() const noexcept { return resource_; }
+  T* allocate(std::size_t n) {
+    if (n > (std::numeric_limits<std::size_t>::max)() / sizeof(T)) throw std::bad_array_new_length();
+    if (resource_) return static_cast<T*>(resource_->allocate(n * sizeof(T), alignof(T)));
+    return numa_allocator<T>(node_).allocate(n);
+  }
+  void deallocate(T* pointer, std::size_t n) noexcept {
+    if (resource_) resource_->deallocate(pointer, n * sizeof(T), alignof(T));
+    else numa_allocator<T>(node_).deallocate(pointer, n);
+  }
+  friend bool operator==(const pool_allocator&, const pool_allocator&) noexcept = default;
+private:
+  template<class> friend class pool_allocator;
+  std::pmr::memory_resource* resource_;
+  int node_;
+};
+template<class T> using pool_vector = std::vector<T, pool_allocator<T>>;
+
+// A successful start transfers one handle; join releases it after the worker returns.
+class pool_thread {
+public:
+  pool_thread(pool_thread_factory factory, void (*run)(void*, std::uint32_t) noexcept,
+              void* context, std::uint32_t index) : factory_(factory) {
+    if (factory_.start) handle_ = factory_.start(factory_.context, run, context, index);
+    else thread_ = std::thread([=] { run(context, index); });
+  }
+  pool_thread(const pool_thread&) = delete;
+  pool_thread& operator=(const pool_thread&) = delete;
+  pool_thread(pool_thread&& other) noexcept
+    : factory_(other.factory_), handle_(std::exchange(other.handle_, nullptr)),
+      thread_(std::move(other.thread_)) {}
+  ~pool_thread() { if (handle_) std::terminate(); }
+  std::thread::id get_id() const noexcept {
+    return handle_ ? factory_.id(handle_) : thread_.get_id();
+  }
+  void join() noexcept {
+    if (handle_) factory_.join(std::exchange(handle_, nullptr));
+    else thread_.join();
+  }
+private:
+  pool_thread_factory factory_;
+  void* handle_{};
+  std::thread thread_;
+};
+}
