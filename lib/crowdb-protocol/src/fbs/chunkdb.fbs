// ── UpdateChunkStrip ─────────────────────────────────────────────

table FBUpdateChunkStripRequest {
    id:uint64;
    rpc_create_nano:uint64;
    chunk_id:crowdb.rpc.proto.FBInt128;
    strip_index:uint32;
    strip:FBChunkStrip;
}

table FBUpdateChunkStripResponse {
    id:uint64;
    rpc_create_nano:uint64;
    ret_code:FBChunkdbRetCode;
    error_msg:string;
    range_start:uint32;
    range_end:uint32;
    chunk:FBChunk;
}

// ── Replacement Allocation + Fenced Range Swap ─────────────────

table FBAllocateReplacementSegmentRequest {
    id:uint64;
    rpc_create_nano:uint64;
    chunk_id:crowdb.rpc.proto.FBInt128;
    old_segment:crowdb.diskdb.proto.FBSegment;
    surviving_segments:[crowdb.diskdb.proto.FBSegment];
    exclude_disk_ids:[crowdb.rpc.proto.FBInt128];
}

table FBAllocateReplacementSegmentResponse {
    id:uint64;
    rpc_create_nano:uint64;
    ret_code:FBChunkdbRetCode;
    error_msg:string;
    range_start:uint32;
    range_end:uint32;
    segment:crowdb.diskdb.proto.FBSegment;
}

table FBDiscardReplacementSegmentRequest {
    id:uint64;
    rpc_create_nano:uint64;
    chunk_id:crowdb.rpc.proto.FBInt128;
    segment:crowdb.diskdb.proto.FBSegment;
}

table FBDiscardReplacementSegmentResponse {
    id:uint64;
    rpc_create_nano:uint64;
    ret_code:FBChunkdbRetCode;
    error_msg:string;
    range_start:uint32;
    range_end:uint32;
}

table FBReplaceChunkStripRangeRequest {
    id:uint64;
    rpc_create_nano:uint64;
    chunk_id:crowdb.rpc.proto.FBInt128;
    expected_modify_ts:uint64;
    start_index:uint32;
    old_strips:[FBChunkStrip];
    replacement_strips:[FBChunkStrip];
    operation_id:crowdb.rpc.proto.FBInt128;
}

table FBReplaceChunkStripRangeResponse {
    id:uint64;
    rpc_create_nano:uint64;
    ret_code:FBChunkdbRetCode;
    error_msg:string;
    range_start:uint32;
    range_end:uint32;
    chunk:FBChunk;
}

// ── ListChunks ───────────────────────────────────────────────────

table FBListChunksRequest {
    id:uint64;
    rpc_create_nano:uint64;
    start_token:crowdb.rpc.proto.FBInt128;
    partition:uint32;
    max_keys:uint32;
}

table FBListChunksResponse {
    id:uint64;
    rpc_create_nano:uint64;
    ret_code:FBChunkdbRetCode;
    error_msg:string;
    range_start:uint32;
    range_end:uint32;
    chunks:[FBChunk];
    next_token:crowdb.rpc.proto.FBInt128;
    has_next_token:bool;
}

// ── Mirror-to-EC Conversion ─────────────────────────────────────

table FBTriggerConversionRequest {
    id:uint64;
    rpc_create_nano:uint64;
    chunk_id:crowdb.rpc.proto.FBInt128;
}

table FBTriggerConversionResponse {
    id:uint64;
    rpc_create_nano:uint64;
    ret_code:FBChunkdbRetCode;
    error_msg:string;
    range_start:uint32;
    range_end:uint32;
    accepted_groups:uint64;
}

table FBTriggerConversionBatchRequest {
    id:uint64;
    rpc_create_nano:uint64;
    sealed_only:bool;
    max_chunks:uint32;
}

table FBTriggerConversionBatchResponse {
    id:uint64;
    rpc_create_nano:uint64;
    ret_code:FBChunkdbRetCode;
    error_msg:string;
    range_start:uint32;
    range_end:uint32;
    accepted_chunks:uint64;
}
