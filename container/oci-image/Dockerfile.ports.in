FROM ubuntu:24.04@sha256:496754492fb28b4d3049432f2ca787449331e23fb14f0dd3fffea86bf5a93eb4
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssh-server util-linux curl tini libibverbs1 librdmacm1 ibverbs-providers ibverbs-utils && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 crowdb \
    && useradd --system --uid 10001 --gid 10001 --home-dir /opt/crowdb --shell /bin/sh crowdb \
    && echo 'crowdb:crowdb' | chpasswd \
    && mkdir -p /run/sshd
ARG SOURCE_REVISION
ARG SOURCE_TREE
ARG RUNTIME_SHA256
ARG PREVIEW_VERSION
ARG DEBUG_INFO=stripped
RUN --mount=type=bind,source=.,target=/staged,ro \
    test -n "$SOURCE_REVISION" && test -n "$PREVIEW_VERSION" \
    && test "$(cat /staged/SOURCE_REVISION)" = "$SOURCE_REVISION" \
    && { test -z "$SOURCE_TREE" || test "$(cat /staged/SOURCE_TREE)" = "$SOURCE_TREE"; } \
    && test "$(cat /staged/VERSION)" = "$PREVIEW_VERSION" \
    && mkdir -p /opt/crowdb/etc /opt/crowdb/data /opt/crowdb/run \
    && cp -a /staged/bin /staged/lib /staged/ui /opt/crowdb/ \
    && if test -d /staged/etc; then cp -a /staged/etc /opt/crowdb/; fi \
    && cp /staged/profile.toml /opt/crowdb/etc/profile.toml \
    && cp /staged/entrypoint.sh /opt/crowdb/bin/entrypoint \
    && chown -R crowdb:crowdb /opt/crowdb/data /opt/crowdb/run \
    && chmod 0755 /opt/crowdb/bin/entrypoint \
    && for binary in /opt/crowdb/bin/crowdb-* /opt/crowdb/lib/* /opt/crowdb/lib/libibverbs/*.so; do \
        test -f "$binary" || continue; \
        LD_LIBRARY_PATH=/opt/crowdb/lib ldd -r "$binary" > /tmp/dependencies.txt 2>&1 || { cat /tmp/dependencies.txt; exit 1; }; \
        if grep -Eq 'not found|undefined symbol' /tmp/dependencies.txt; then cat /tmp/dependencies.txt; exit 1; fi; \
    done && rm /tmp/dependencies.txt

LABEL org.opencontainers.image.title="CROWDB Node" \
      org.opencontainers.image.description="CROWDB node with discovery, management UI and storage services." \
      org.opencontainers.image.url="https://crowdb.dev/" \
      org.opencontainers.image.source="https://github.com/buzzcrow/crowdb" \
      org.opencontainers.image.authors="Gian <crow.db@outlook.com>" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.crowdb.source.tree="$SOURCE_TREE" \
      org.opencontainers.image.version="$PREVIEW_VERSION" \
      org.crowdb.runtime.sha256="$RUNTIME_SHA256" \
      org.crowdb.debug-info="$DEBUG_INFO" \
      org.crowdb.startup.default="local"
ENV PATH="/opt/crowdb/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/crowdb/lib" \
    RDMAV_DRIVERS_DIR="/opt/crowdb/lib/libibverbs" \
    CROWDB_RUNTIME_ROOT="/opt/crowdb/run"
USER root
VOLUME ["/opt/crowdb/data"]
EXPOSE @PAXOS_KV_SERVER_MGMT_BASE@ @PAXOS_KV_SERVER_RPC_BASE@ @DISKDB_HTTP_BASE@ @DISKDB_RPC_BASE@ @CHUNKDB_HTTP_BASE@ @CHUNKDB_RPC_BASE@ @DISKIO_RPC_BASE@ @WEB_BASE@ @CHUNK_KV_HTTP_BASE@ @CHUNK_KV_RPC_BASE@ @ACCESS_SERVER_HTTP_BASE@ @ACCESS_SERVER_ICEBERG_HTTP_BASE@ @ACCESS_SERVER_DATASET_HTTP_BASE@ @ACCESS_SERVER_HEALTH_HTTP_BASE@ @MONITOR_HTTP_BASE@ @SSH_PORT@
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/crowdb/bin/entrypoint"]
