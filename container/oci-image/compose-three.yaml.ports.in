name: crowdb-${CROWDB_CLUSTER:-local-three}
x-node: &node
  image: ${CROWDB_IMAGE:-crowdb-node:dev}
  pull_policy: never
  cpus: 1
  mem_limit: 1536m
services:
  node1:
    <<: *node
    environment:
      CROWDB_CLUSTER: ${CROWDB_CLUSTER:-local-three}
      CROWDB_INITIAL_VOTERS: "3"
      CROWDB_S3_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE1_S3_PORT:-@ACCESS_SERVER_HTTP_BASE@}
      CROWDB_ICEBERG_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE1_ICEBERG_PORT:-@ACCESS_SERVER_ICEBERG_HTTP_BASE@}
      CROWDB_DATASET_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE1_DATASET_PORT:-@ACCESS_SERVER_DATASET_HTTP_BASE@}
    ports:
      - "127.0.0.1:${CROWDB_NODE1_UI_PORT:-@WEB_BASE@}:@WEB_BASE@"
      - "127.0.0.1:${CROWDB_NODE1_S3_PORT:-@ACCESS_SERVER_HTTP_BASE@}:@ACCESS_SERVER_HTTP_BASE@"
      - "127.0.0.1:${CROWDB_NODE1_ICEBERG_PORT:-@ACCESS_SERVER_ICEBERG_HTTP_BASE@}:@ACCESS_SERVER_ICEBERG_HTTP_BASE@"
      - "127.0.0.1:${CROWDB_NODE1_DATASET_PORT:-@ACCESS_SERVER_DATASET_HTTP_BASE@}:@ACCESS_SERVER_DATASET_HTTP_BASE@"
    volumes:
      - node1-data:/opt/crowdb/data
  node2:
    <<: *node
    environment:
      CROWDB_CLUSTER: ${CROWDB_CLUSTER:-local-three}
      CROWDB_INITIAL_VOTERS: "3"
      CROWDB_S3_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE2_S3_PORT:-@ACCESS_SERVER_HTTP_BASE+1@}
      CROWDB_ICEBERG_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE2_ICEBERG_PORT:-@ACCESS_SERVER_ICEBERG_HTTP_BASE+1@}
      CROWDB_DATASET_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE2_DATASET_PORT:-@ACCESS_SERVER_DATASET_HTTP_BASE+1@}
    ports:
      - "127.0.0.1:${CROWDB_NODE2_UI_PORT:-@WEB_BASE+1@}:@WEB_BASE@"
      - "127.0.0.1:${CROWDB_NODE2_S3_PORT:-@ACCESS_SERVER_HTTP_BASE+1@}:@ACCESS_SERVER_HTTP_BASE@"
      - "127.0.0.1:${CROWDB_NODE2_ICEBERG_PORT:-@ACCESS_SERVER_ICEBERG_HTTP_BASE+1@}:@ACCESS_SERVER_ICEBERG_HTTP_BASE@"
      - "127.0.0.1:${CROWDB_NODE2_DATASET_PORT:-@ACCESS_SERVER_DATASET_HTTP_BASE+1@}:@ACCESS_SERVER_DATASET_HTTP_BASE@"
    volumes:
      - node2-data:/opt/crowdb/data
  node3:
    <<: *node
    environment:
      CROWDB_CLUSTER: ${CROWDB_CLUSTER:-local-three}
      CROWDB_INITIAL_VOTERS: "3"
      CROWDB_S3_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE3_S3_PORT:-@ACCESS_SERVER_HTTP_BASE+2@}
      CROWDB_ICEBERG_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE3_ICEBERG_PORT:-@ACCESS_SERVER_ICEBERG_HTTP_BASE+2@}
      CROWDB_DATASET_PUBLIC_URI: http://127.0.0.1:${CROWDB_NODE3_DATASET_PORT:-@ACCESS_SERVER_DATASET_HTTP_BASE+2@}
    ports:
      - "127.0.0.1:${CROWDB_NODE3_UI_PORT:-@WEB_BASE+2@}:@WEB_BASE@"
      - "127.0.0.1:${CROWDB_NODE3_S3_PORT:-@ACCESS_SERVER_HTTP_BASE+2@}:@ACCESS_SERVER_HTTP_BASE@"
      - "127.0.0.1:${CROWDB_NODE3_ICEBERG_PORT:-@ACCESS_SERVER_ICEBERG_HTTP_BASE+2@}:@ACCESS_SERVER_ICEBERG_HTTP_BASE@"
      - "127.0.0.1:${CROWDB_NODE3_DATASET_PORT:-@ACCESS_SERVER_DATASET_HTTP_BASE+2@}:@ACCESS_SERVER_DATASET_HTTP_BASE@"
    volumes:
      - node3-data:/opt/crowdb/data
volumes:
  node1-data:
  node2-data:
  node3-data:
