version = 1
name = "single-node-container"
display_name = "CROWDB Single-Node Container"
placement_mode = "unsafe-colocated"
s3_tenant = "preview"
iceberg_catalog = "preview"

[paths]
install_root = "/opt/crowdb"
bin_root = "/opt/crowdb/bin"
template_root = "/opt/crowdb/etc/templates"
data_root = "/opt/crowdb/data"
run_root = "/opt/crowdb/run"
log_root = "/opt/crowdb/data/log"

[logs]
max_file_bytes = 31457280
max_files = 5
mirror_warnings_to_stderr = true

[[nodes]]
node_id = 1
rack_id = 1

[[groups]]
store_id = 0
group_id = 0
replica_id = 1
node_id = 1
rpc_endpoint = "127.0.0.1:@PAXOS_KV_SERVER_RPC_BASE@"
role = "system"

[[groups]]
store_id = 0
group_id = 1
replica_id = 2
node_id = 1
rpc_endpoint = "127.0.0.1:@PAXOS_KV_SERVER_RPC_BASE@"
role = "data"

[[disks]]
disk_id = "00000000000000010000000000000001"
disk_group_id = 101
node_id = 1
path = "/opt/crowdb/data/disks/disk-0001.img"
capacity_bytes = 17179869184
zone_size_bytes = 17179869184

[[disks]]
disk_id = "00000000000000010000000000000002"
disk_group_id = 101
node_id = 1
path = "/opt/crowdb/data/disks/disk-0002.img"
capacity_bytes = 17179869184
zone_size_bytes = 17179869184

[[disks]]
disk_id = "00000000000000010000000000000003"
disk_group_id = 101
node_id = 1
path = "/opt/crowdb/data/disks/disk-0003.img"
capacity_bytes = 17179869184
zone_size_bytes = 17179869184

[[disks]]
disk_id = "00000000000000010000000000000004"
disk_group_id = 101
node_id = 1
path = "/opt/crowdb/data/disks/disk-0004.img"
capacity_bytes = 17179869184
zone_size_bytes = 17179869184

[[public_endpoints]]
id = "s3"
bind = "0.0.0.0"
port = @ACCESS_SERVER_HTTP_BASE@

[[public_endpoints]]
id = "iceberg"
bind = "0.0.0.0"
port = @ACCESS_SERVER_ICEBERG_HTTP_BASE@

[[public_endpoints]]
id = "web"
bind = "0.0.0.0"
port = @WEB_BASE@

[[services]]
id = "kv"
env = { CROWDB_RDMA_SERVICE_SLOT = "1" }
program = "/opt/crowdb/bin/crowdb-paxos-kv-server"
args = ["--root", "/opt/crowdb/data/kv/node-1", "--config", "/opt/crowdb/run/config/kv.toml", "--management-port", "@PAXOS_KV_SERVER_MGMT_BASE@", "--ports", "@PAXOS_KV_SERVER_RPC_BASE@,@PAXOS_KV_SERVER_RPC_BASE+1@", "--instance-id", "1", "--node-id", "1", "--binding-monitor-interval", "1", "--log-dir", "/opt/crowdb/data/log/kv", "--log"]
dependencies = []
fence_listeners = ["127.0.0.1:@PAXOS_KV_SERVER_MGMT_BASE@", "127.0.0.1:@PAXOS_KV_SERVER_RPC_BASE@", "127.0.0.1:@PAXOS_KV_SERVER_RPC_BASE+1@"]
config_template = "/opt/crowdb/etc/templates/kv.toml"
[services.probe]
kind = "http"
target = "http://127.0.0.1:@PAXOS_KV_SERVER_MGMT_BASE@/health"
timeout_ms = 1000
failure_threshold = 5
[services.restart]
max_attempts = 5
backoff_base_ms = 250
backoff_max_ms = 5000

[[services]]
id = "diskdb"
env = { CROWDB_RDMA_SERVICE_SLOT = "2" }
program = "/opt/crowdb/bin/crowdb-diskdb"
args = ["--config", "/opt/crowdb/run/config/diskdb.toml", "--log-dir", "/opt/crowdb/data/log/diskdb", "--log"]
dependencies = ["kv"]
fence_listeners = ["127.0.0.1:@DISKDB_HTTP_BASE@", "127.0.0.1:@DISKDB_RPC_BASE@"]
config_template = "/opt/crowdb/etc/templates/diskdb.toml"
[services.probe]
kind = "http"
target = "http://127.0.0.1:@DISKDB_HTTP_BASE@/health"
timeout_ms = 1000
failure_threshold = 5
[services.restart]
max_attempts = 5
backoff_base_ms = 250
backoff_max_ms = 5000

[[services]]
id = "diskio"
env = { CROWDB_RDMA_SERVICE_SLOT = "3" }
program = "/opt/crowdb/bin/crowdb-diskio"
args = ["--config", "/opt/crowdb/run/config/diskio.toml"]
dependencies = ["kv", "diskdb"]
fence_listeners = ["127.0.0.1:@DISKIO_RPC_BASE@"]
config_template = "/opt/crowdb/etc/templates/diskio.toml"
[services.probe]
kind = "rpc-ping"
target = "127.0.0.1:@DISKIO_RPC_BASE@"
timeout_ms = 1000
failure_threshold = 5
[services.restart]
max_attempts = 5
backoff_base_ms = 250
backoff_max_ms = 5000

[[services]]
id = "chunkdb"
env = { CROWDB_RDMA_SERVICE_SLOT = "4" }
program = "/opt/crowdb/bin/crowdb-chunkdb"
args = ["--config", "/opt/crowdb/run/config/chunkdb.toml", "--log-dir", "/opt/crowdb/data/log/chunkdb", "--log"]
dependencies = ["kv", "diskdb", "diskio"]
fence_listeners = ["127.0.0.1:@CHUNKDB_HTTP_BASE@", "127.0.0.1:@CHUNKDB_RPC_BASE@"]
config_template = "/opt/crowdb/etc/templates/chunkdb.toml"
[services.probe]
kind = "http"
target = "http://127.0.0.1:@CHUNKDB_HTTP_BASE@/ready"
timeout_ms = 1000
failure_threshold = 5
[services.restart]
max_attempts = 5
backoff_base_ms = 250
backoff_max_ms = 5000

[[services]]
id = "chunk-kv"
env = { CROWDB_RDMA_SERVICE_SLOT = "5" }
program = "/opt/crowdb/bin/crowdb-chunk-kv-server"
args = ["--config", "/opt/crowdb/run/config/chunk-kv.toml", "--log-dir", "/opt/crowdb/data/log/chunk-kv", "--log"]
dependencies = ["kv", "chunkdb", "diskio"]
fence_listeners = ["127.0.0.1:@CHUNK_KV_HTTP_BASE@", "127.0.0.1:@CHUNK_KV_RPC_BASE@"]
config_template = "/opt/crowdb/etc/templates/chunk-kv.toml"
[services.probe]
kind = "http"
target = "http://127.0.0.1:@CHUNK_KV_HTTP_BASE@/health"
timeout_ms = 1000
failure_threshold = 5
[services.restart]
max_attempts = 5
backoff_base_ms = 250
backoff_max_ms = 5000

[[services]]
id = "access"
program = "/opt/crowdb/bin/crowdb-access-server"
args = ["--config", "/opt/crowdb/run/config/access.toml"]
env = { CROWDB_S3_PUBLIC_URI = "http://localhost:@ACCESS_SERVER_HTTP_BASE@", CROWDB_S3_REGION = "us-east-1", CROWDB_ICEBERG_PUBLIC_URI = "http://localhost:@ACCESS_SERVER_ICEBERG_HTTP_BASE@", CROWDB_DATASET_PUBLIC_URI = "http://localhost:@ACCESS_SERVER_DATASET_HTTP_BASE@", CROWDB_ICEBERG_GC_ENABLED = "0", CROWDB_MANAGEMENT_SEEDS = "http://127.0.0.1:@PAXOS_KV_SERVER_MGMT_BASE@", CROWDB_ACCESS_HEALTH_LISTEN = "127.0.0.1:@ACCESS_SERVER_HEALTH_HTTP_BASE@", CROWDB_ACCESS_LOG_DIR = "/opt/crowdb/data/log/access", CROWDB_RDMA_SERVICE_SLOT = "6" }
dependencies = ["kv", "chunk-kv", "chunkdb", "diskio"]
fence_listeners = ["127.0.0.1:@ACCESS_SERVER_ICEBERG_HTTP_BASE@", "127.0.0.1:@ACCESS_SERVER_HTTP_BASE@", "127.0.0.1:@ACCESS_SERVER_DATASET_HTTP_BASE@", "127.0.0.1:@ACCESS_SERVER_HEALTH_HTTP_BASE@"]
config_template = "/opt/crowdb/etc/templates/access.toml"
[services.probe]
kind = "http"
target = "http://127.0.0.1:@ACCESS_SERVER_ICEBERG_HTTP_BASE@/v1/config"
bearer_env = "CROWDB_ICEBERG_READ_TOKEN"
timeout_ms = 1000
failure_threshold = 5
[[services.additional_probes]]
kind = "http"
target = "http://127.0.0.1:@ACCESS_SERVER_HEALTH_HTTP_BASE@/_crowdb/health/ready"
timeout_ms = 1000
failure_threshold = 5
[services.restart]
max_attempts = 5
backoff_base_ms = 250
backoff_max_ms = 5000

[[services]]
id = "web"
env = { CROWDB_RDMA_SERVICE_SLOT = "7" }
program = "/opt/crowdb/bin/crowdb-web"
args = ["--config", "/opt/crowdb/run/config/crowdb-web.toml", "--node-monitor", "http://127.0.0.1:@MONITOR_HTTP_BASE@"]
dependencies = ["access"]
fence_listeners = ["127.0.0.1:@WEB_BASE@"]
config_template = "/opt/crowdb/etc/templates/crowdb-web.toml"
[services.probe]
kind = "http"
target = "http://127.0.0.1:@WEB_BASE@/healthz"
timeout_ms = 1000
failure_threshold = 5
[services.restart]
max_attempts = 5
backoff_base_ms = 250
backoff_max_ms = 5000
