version = 1
mode = "docker"
readonly = true
bind = "0.0.0.0"
port = @WEB_BASE@
group0_management_seeds = ["http://127.0.0.1:@PAXOS_KV_SERVER_MGMT_BASE@"]
ui_root = "{{install_root}}/ui"
monitor_status = "{{run_root}}/status/monitor.json"
log_dir = "{{log_root}}/web"
log_max_file_mb = 30
log_max_files = 5
