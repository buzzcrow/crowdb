---
# Suppressed checks — fix-its are unsafe or the warning source is
# third-party macro noise. See coding SKILL.md § "C++ clang-tidy".
# These checks can change ownership, ABI, overload resolution, or hot-path
# behavior through their fix-its; keep them visible only when reviewed locally.
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-unnecessary-value-param,
  -performance-move-const-arg,
  -readability-convert-member-functions-to-static,
  -modernize-use-ranges,
  -modernize-avoid-c-arrays,
  -readability-non-const-parameter,
  -readability-trailing-comma
WarningsAsErrors: ''
HeaderFilterRegex: '(^|.*/)(crowdb-tree/(include|src|tests)|crowdb-common/cpp|crowdb-rpc/(include|src|tests))/.*'
ExcludeHeaderFilterRegex: '(^|.*/)(\.pixi|usr/include|usr/local/include|third-party)/.*'
FormatStyle: file
CheckOptions:
  - key: modernize-use-nodiscard.ReplacementString
    value: '[[nodiscard]]'
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
