---
# Suppressed checks — fix-its are unsafe or the warning source is
# third-party macro noise.
# These checks can change ownership, ABI, overload resolution, or hot-path
# behavior through their fix-its; keep them visible only when reviewed locally.
# Public member const-qualification changes C++ ABI and requires deliberate
# interface review rather than a lint-driven conversion.
# Fixed async completion tokens transfer heap ownership through opaque context
# pointers. NewDeleteLeaks does not model the backend invoking their deleters;
# completion ownership is covered by ASan and async lifetime tests instead.
Checks: >-
  -*,
  clang-analyzer-*,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-unnecessary-value-param,
  -performance-move-const-arg,
  -readability-convert-member-functions-to-static,
  -readability-make-member-function-const,
  -modernize-use-ranges,
  -modernize-avoid-c-arrays,
  -readability-non-const-parameter,
  -readability-trailing-comma
WarningsAsErrors: ''
HeaderFilterRegex: '(^|.*/)(crowdb-tree/(include|src|tests)|crowdb-common/cpp|crowdb-rpc/(include|src|tests))/.*'
ExcludeHeaderFilterRegex: '(^|.*/)(\.pixi|usr/include|usr/local/include|third-party)/.*'
FormatStyle: file
CheckOptions:
  - key: modernize-use-nodiscard.ReplacementString
    value: '[[nodiscard]]'
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
